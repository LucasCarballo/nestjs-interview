{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@nestjs/jwt$": "<rootDir>/__mocks__/@nestjs/jwt.ts",
    "^bcrypt$": "<rootDir>/__mocks__/bcrypt.ts"
  }
}
